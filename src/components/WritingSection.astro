---
---

<section id="writing" class="fade-in">
  <div class="subscribe-box" id="subscribe">
    <p class="subscribe-title">Get my essays by email</p>
    <p class="subscribe-desc">No spam. Unsubscribe anytime.</p>
    <div class="substack-wrapper">
      <iframe
        src="https://adityaaswani.substack.com/embed"
        title="Subscribe to Aditya Aswani's Substack"
        width="100%"
        height="150"
        style="border: none; background: transparent; display: block; overflow: hidden;"
      ></iframe>
    </div>
  </div>
</section>

<style>
  section {
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .subscribe-box {
    max-width: 800px;
    margin: 3rem auto 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 2rem;
    text-align: center;
  }

  .subscribe-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.25rem;
  }

  .subscribe-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0 0 1.25rem;
  }

  .substack-wrapper {
    border-radius: 10px;
    overflow: hidden;
  }


</style>